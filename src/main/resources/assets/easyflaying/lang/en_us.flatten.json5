{
  easyflaying: {
    entry: {
      interop: {
        tradermanip: "Trader Manipulation",
        traderflay: "Flaying Traders"
      }
    },
    page: {
      tradermanip: {
        itemize: "Transforms a villager into a villager item, or a villager item back into a villager. Costs one $(l:items/amethyst)$(item)Amethyst Shard/$.",
        yoink: "Inserts a villager or itemized villager into a trader. Costs one $(l:items/amethyst)$(item)Amethyst Shard/$.",
        "expel/": {
          villager: "Removes the villager from a trader, and returns it to the world as a live villager. Costs one $(l:items/amethyst)$(item)Amethyst Shard/$.",
          item: "Removes the villager from a trader, and returns it to the world as an item. Costs one $(l:items/amethyst)$(item)Amethyst Shard/$."
        }
      },
      traderflay: {
        tradersweep: "$(l:patterns/great_spells/brainsweep)$(action)Flay mind/$ can now accept the position of a trader as the sacrifice."
      }
    },
    configuration: {
      title: "Easy Flaying Configs",
      "section.easyflaying.common.toml": {
        "": "Easy Flaying Configs",
        title: "Easy Flaying Configs"
      }
    }
  },
  hexcasting: {
    action: {
      "easyflaying:": {
        "villager/": {
          itemize: "insert name here",
          yoink: "Entrap Villager",
          "expel/": {
            villager: "Expel Villager",
            item: "Expel Villager II"
          }
        },
      }
    },
    mishap: {
      bad_block: {
        "easyflaying:": {
          filled_trader: "a non-empty trader",
          empty_trader: "an empty trader"
        }
      },
      invalid_value: {
        "easyflaying:": {
          villager: "a living or itemized villager"
        }
      }
    }
  }
}
